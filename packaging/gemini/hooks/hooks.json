{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "name": "assume-nothing-probe", "command": "\"${extensionPath}${/}scripts${/}run.sh\" hook --agent gemini SessionStart", "timeout": 15000 }
        ]
      }
    ],
    "BeforeTool": [
      {
        "matcher": ".*",
        "hooks": [
          { "type": "command", "name": "assume-nothing-gate", "command": "\"${extensionPath}${/}scripts${/}run.sh\" hook --agent gemini BeforeTool", "timeout": 15000 }
        ]
      }
    ],
    "AfterTool": [
      {
        "matcher": "run_shell_command",
        "hooks": [
          { "type": "command", "name": "assume-nothing-recheck", "command": "\"${extensionPath}${/}scripts${/}run.sh\" hook --agent gemini AfterTool", "timeout": 15000 }
        ]
      }
    ]
  }
}
